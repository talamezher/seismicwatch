# Copy this file to .env and fill it in. .env is never committed (see .gitignore).
# None of the three sources needs an API key; these settings stay out of the code anyway.

# Contact address added to the User-Agent of every request (USGS, GeoNames, Wikipedia ask for one)
SEISMICWATCH_CONTACT_EMAIL=

# Optional: where data/ and logs/ live (default: inside the project folder)
# SEISMICWATCH_DATA_DIR=data
# SEISMICWATCH_LOG_DIR=logs

# Optional: USGS page size (the API allows up to 20000)
# USGS_PAGE_SIZE=1000
